{
  "name": "modbank-fintech-challenge",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-friendly FinTech engineering booth challenge for students.",
  "scripts": {
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build --configuration production",
    "build:dev": "ng build --configuration development",
    "test": "node --import tsx --test src/app/core/*.spec.ts",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.38.0",
    "codemirror": "^6.0.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "@types/node": "^22.15.0"
  },
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0"
  }
}
